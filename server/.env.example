# Nokia Network-as-Code API Configuration
NOKIA_API_BASE_URL=https://network-as-code.nokia.com/api/v1
NOKIA_API_KEY=your_nokia_api_key_here
NOKIA_CLIENT_ID=your_client_id_here
NOKIA_CLIENT_SECRET=your_client_secret_here

# Database
MONGODB_URI=mongodb://localhost:27017/agriguard

# JWT
JWT_SECRET=your_jwt_secret_here

# OpenAI for AI Agents
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=5000
NODE_ENV=development

# External APIs
WEATHER_API_KEY=your_weather_api_key_here
PAYMENT_GATEWAY_KEY=your_payment_key_here